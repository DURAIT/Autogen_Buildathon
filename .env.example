# OpenAI (cloud)
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini

# For Ollama/OpenAI-compatible local endpoints, uncomment and adjust:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=local-model
# MODEL_NAME=qwen2.5:7b

DATA_DIR=data
CONFIDENCE_THRESHOLD=0.70
RETRIEVAL_MIN_SCORE=0.20

# Calibrate this threshold for the selected embedding model using representative queries.
# Hybrid retrieval gates vector candidates, then orders eligible FAISS/BM25 hits with RRF.
# "local" (the default) loads a small fully-local sentence-transformers model
# (all-MiniLM-L6-v2, 384 dims) for real semantic retrieval, fully offline and with
# no API key required. "hashing" is lightweight lexical hashing, kept for a
# dependency-light fallback. "openai-compatible" delegates to a remote embeddings
# endpoint for semantic retrieval when you prefer a hosted/larger model.
EMBEDDING_BACKEND=local
# EMBEDDING_BACKEND=hashing
# EMBEDDING_BACKEND=openai-compatible
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768
# EMBEDDING_API_KEY=local-only
EMBEDDING_TIMEOUT_SECONDS=30
ENABLE_LLM_RERANK=true

# Start mcp_server.py before app.py. The bundled server enforces loopback-only binding.
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_TIMEOUT_SECONDS=20

# Escalations and human-approved replies are routed to the support mailbox below.
# Add SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD and SMTP_SENDER in your private .env.
ENABLE_ESCALATION_EMAIL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SUPPORT_EMAIL=support@example.com

# Optional. Sync is disabled by default and only runs through the explicit admin function.
ENABLE_GOOGLE_SHEETS_SYNC=false
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=
